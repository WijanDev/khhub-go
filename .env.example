# Copy to .env for local development. Never commit real secrets.

# Postgres
POSTGRES_USER=khhub
POSTGRES_PASSWORD=khhub_dev_only
POSTGRES_DB=khhub
DATABASE_URL=postgres://khhub:khhub_dev_only@localhost:5432/khhub?sslmode=disable

# API
# development: auto-loads demo data when publishers is empty; reset button on Congregation.
# production: no demo seed, no reset endpoint.
APP_ENV=development
HTTP_ADDR=:8080
# Comma-separated origins allowed to send credentials.
# Local: Vite origin. Production: https://khhub.app (API is on api.khhub.app).
CORS_ORIGINS=http://localhost:5173
# Cookie Secure flag. Leave false for http://localhost.
COOKIE_SECURE=false
# Random 32+ character string used to derive nothing today; kept for future signing needs.
SESSION_SECRET=change-me-to-a-long-random-string

# Seeded on first boot when the users table is empty. Change immediately after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Vite (frontend). No trailing slash. Local API on the host.
# Docker web images ignore this and read KHHUB_API_URL at container start.
VITE_API_URL=http://127.0.0.1:8080
